<%@ page contentType="text/html; charset=UTF-8" %><!DOCTYPE html><html><head><meta charset="UTF-8"><title>Xác thực OTP</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css"></head><body><main class="section"><div class="container login-wrap"><form class="form login-form" action="${pageContext.request.contextPath}/verify-otp" method="post"><h1>Xác thực tài khoản</h1><p class="muted">Nhập mã OTP 6 chữ số đã được gửi đến email của bạn.</p><%if(request.getAttribute("error")!=null){%><div class="alert error"><%=request.getAttribute("error")%></div><%}%><input name="otp" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" required><button class="btn">Xác thực</button></form></div></main></body></html>
